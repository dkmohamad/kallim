WEBVTT

00:00:00.000 --> 00:00:04.690
{"n": 1, "speaker": "david", "label": "ديفيد", "section": "التَّحِيَّةُ وَالأَحْوَال", "ar": "مَرْحَبًا يَا أُسْتَاذَة. كَيْفَ الحَالُ؟", "en": "Hello, teacher. How are you?"}

00:00:05.390 --> 00:00:11.009
{"n": 2, "speaker": "teacher", "label": "المعلِّمة", "section": "التَّحِيَّةُ وَالأَحْوَال", "ar": "أَنَا بِخَيْرٍ، شُكْرًا. كُلُّ شَيْءٍ عَلَى مَا يُرَامُ.", "en": "I'm well, thank you. Everything is going fine."}

00:00:11.709 --> 00:00:22.344
{"n": 3, "speaker": "david", "label": "ديفيد", "section": "التَّحِيَّةُ وَالأَحْوَال", "ar": "«عَلَى مَا يُرَامُ» — مَاذَا يَعْنِي؟", "en": "\"ʿalā mā yurām\" — what does it mean?"}

00:00:23.044 --> 00:00:26.063
{"n": 4, "speaker": "teacher", "label": "المعلِّمة", "section": "التَّحِيَّةُ وَالأَحْوَال", "ar": "يَعْنِي كُلُّ شَيْءٍ جَيِّدٌ.", "en": "It means everything is good."}

